# BlackPod Navigator — environment configuration
# Copy to `.env` (backend reads .env automatically) and adjust per environment.
# All backend settings use the BPN_ prefix.

# --- Market data provider --------------------------------------------------
# "yfinance" = live data from Yahoo Finance (default).
# "synthetic" = deterministic, network-free data (tests / offline / demos).
BPN_PROVIDER=yfinance

# --- Cache / stale fallback ------------------------------------------------
# Fresh-cache TTL in seconds (how long before a re-fetch is attempted).
BPN_CACHE_TTL_SECONDS=60
# Max age a stale entry may be served when the provider fails. 0 disables.
BPN_CACHE_STALE_MAX_SECONDS=604800
# On-disk cache directory (persists across restarts). Empty = memory-only.
BPN_CACHE_DIR=.cache

# --- CORS / abuse controls -------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call the API.
# In production set this to your real frontend origin(s) and disable e2b.
BPN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Allow any *.e2b.app preview origin. Set to false in real production.
BPN_ALLOW_E2B_PREVIEW=true

# Per-IP rate limits (slowapi syntax, e.g. "60/minute").
BPN_RATE_LIMIT_OHLC=60/minute
BPN_RATE_LIMIT_TICKERS=120/minute
BPN_RATE_LIMIT_DEFAULT=240/minute

# --- Deployment ------------------------------------------------------------
# development | staging | production. "production" hardens CORS ("*" rejected).
BPN_ENVIRONMENT=development
# Directory of built frontend assets to serve from the API (single-container).
# The provided Dockerfile sets this to "static".
BPN_STATIC_DIR=

# --- Frontend (Vite, build-time) -------------------------------------------
# Override the API base URL the browser calls. Leave unset to auto-detect:
#   - e2b preview  -> 8000- subdomain
#   - localhost    -> http://localhost:8000
#   - production   -> same-origin (served by the API container)
# VITE_API_BASE=https://api.example.com