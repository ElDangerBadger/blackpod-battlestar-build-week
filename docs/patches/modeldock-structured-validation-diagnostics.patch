+++ b/tests/test_structured_validation_diagnostics.py
@@ -0,0 +1,170 @@
+"""Offline-only metadata privacy regressions; no model or tokenizer fixture."""
+
+from copy import deepcopy
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from src.api.errors import ModelDockError
+from src.router.request_router import RequestRouter
+from src.validation.structured import validate_result
+
+
+SCHEMA = {
+    "type": "object",
+    "properties": {"value": {"type": "integer", "minimum": 0}},
+    "required": ["value"],
+    "additionalProperties": False,
+}
+PRIVATE = "PRIVATE_MODEL_TEXT_OR_KEY_28a7"
+NATIVE = {
+    "generated_token_count": 2500,
+    "generated_token_count_source": "native",
+    "stop_reason": "length",
+    "stop_reason_source": "native",
+    "private_text": PRIVATE,
+    "execution_provenance": {"private": PRIVATE},
+}
+DETAIL_KEYS = {
+    "schema", "stage", "reason", "schema_keyword", "generated_token_count",
+    "generated_token_count_source", "stop_reason", "stop_reason_source",
+}
+
+
+def diagnostic(content, *, schema=SCHEMA, mocked=False, telemetry=NATIVE):
+    with pytest.raises(ModelDockError) as caught:
+        validate_result(content, schema, mocked=mocked, telemetry=telemetry)
+    error = caught.value
+    assert error.code == "STRUCTURED_OUTPUT_INVALID"
+    assert error.status_code == 500
+    assert error.message == "The generated result is not valid JSON conforming to the requested schema."
+    assert isinstance(error.details, list) and len(error.details) == 1
+    detail = error.details[0]
+    assert set(detail) == DETAIL_KEYS
+    assert detail["schema"] == "modeldock.structured-validation-diagnostic.v1"
+    assert detail["stage"] == "RESULT_VALIDATION"
+    assert PRIVATE not in json.dumps(error.details)
+    assert PRIVATE not in error.message
+    return detail
+
+
+@pytest.mark.parametrize("content,reason,keyword", [
+    ('{"value":', "JSON_SYNTAX", None),
+    ('{"value":"' + PRIVATE + '"}', "SCHEMA_VIOLATION", "type"),
+    ('{"' + PRIVATE + '":1}', "SCHEMA_VIOLATION", "required"),
+    ('{"value":1,"' + PRIVATE + '":1}', "SCHEMA_VIOLATION", "additionalProperties"),
+    ('{"value":-1}', "SCHEMA_VIOLATION", "minimum"),
+    ('{"value":1,"value":2}', "AMBIGUOUS_JSON", None),
+    ('{"value":NaN}', "INVALID_JSON_NUMBER", None),
+    ('{"value":Infinity}', "INVALID_JSON_NUMBER", None),
+    ('{"value":1e9999}', "INVALID_JSON_NUMBER", None),
+    (None, "VALIDATION_FAILURE", None),
+])
+def test_reason_categories_never_disclose_content(content, reason, keyword):
+    detail = diagnostic(content)
+    assert detail["reason"] == reason
+    assert detail["schema_keyword"] == keyword
+    assert detail["generated_token_count"] == 2500
+    assert detail["generated_token_count_source"] == "native"
+    assert detail["stop_reason"] == "length"
+    assert detail["stop_reason_source"] == "native"
+
+
+def test_mock_cannot_claim_native_telemetry():
+    detail = diagnostic('{"value":1}', mocked=True)
+    assert detail["reason"] == "MOCK_OUTPUT"
+    assert detail["schema_keyword"] is None
+    assert detail["generated_token_count"] is None
+    assert detail["generated_token_count_source"] == "unavailable"
+    assert detail["stop_reason"] == "unknown"
+    assert detail["stop_reason_source"] == "unavailable"
+
+
+@pytest.mark.parametrize("telemetry", [
+    None, {}, PRIVATE,
+    {"generated_token_count": 2500, "stop_reason": "length"},
+    {"generated_token_count": 2500, "generated_token_count_source": "estimated", "stop_reason": "length", "stop_reason_source": "inferred"},
+    {"generated_token_count": True, "generated_token_count_source": "native", "stop_reason": PRIVATE, "stop_reason_source": "native"},
+    {"generated_token_count": -1, "generated_token_count_source": "native", "stop_reason": None, "stop_reason_source": "native"},
+    {"generated_token_count": 2**63, "generated_token_count_source": "native", "stop_reason": [PRIVATE], "stop_reason_source": "native"},
+    {"generated_token_count": 2500.0, "generated_token_count_source": "native", "stop_reason": "unknown", "stop_reason_source": "native"},
+])
+def test_missing_invalid_and_inferred_telemetry_remain_unavailable(telemetry):
+    detail = diagnostic('{"value":', telemetry=telemetry)
+    assert detail["generated_token_count"] is None
+    assert detail["generated_token_count_source"] == "unavailable"
+    assert detail["stop_reason"] == "unknown"
+    assert detail["stop_reason_source"] == "unavailable"
+
+
+@pytest.mark.parametrize("reason", ["stop", "length"])
+def test_native_stop_is_reported_without_inferring_why_validation_failed(reason):
+    telemetry = {**NATIVE, "stop_reason": reason, "generated_token_count": 0}
+    detail = diagnostic('{"value":"wrong-type"}', telemetry=telemetry)
+    assert detail["reason"] == "SCHEMA_VIOLATION"
+    assert detail["stop_reason"] == reason
+    assert detail["generated_token_count"] == 0
+
+
+def test_legacy_call_still_rejects_without_telemetry():
+    with pytest.raises(ModelDockError) as caught:
+        validate_result('{"value":', SCHEMA, mocked=False)
+    assert caught.value.details[0]["generated_token_count_source"] == "unavailable"
+
+
+def test_success_does_not_modify_input_or_telemetry():
+    schema, telemetry = deepcopy(SCHEMA), deepcopy(NATIVE)
+    assert validate_result(' {"value":1}\n', schema, mocked=False, telemetry=telemetry) is None
+    assert schema == SCHEMA
+    assert telemetry == NATIVE
+
+
+def test_router_supplies_only_existing_provider_telemetry_to_failure_gate():
+    router = RequestRouter.__new__(RequestRouter)
+    response = SimpleNamespace(content='{"value":', metadata=deepcopy(NATIVE), mocked=False)
+    context = SimpleNamespace(
+        response_format={"type": "json_schema", "schema": SCHEMA},
+        trace=SimpleNamespace(trace_id="fixture-trace-123"),
+    )
+    with pytest.raises(ModelDockError) as caught:
+        router._text_api_response(context, response)
+    detail = caught.value.details[0]
+    assert detail["reason"] == "JSON_SYNTAX"
+    assert detail["generated_token_count"] == 2500
+    assert detail["stop_reason"] == "length"
+    assert PRIVATE not in json.dumps(caught.value.details)
+    assert response.metadata == NATIVE
+
+
+def test_router_log_contains_only_closed_details_and_trace_id(caplog):
+    router = RequestRouter.__new__(RequestRouter)
+    response = SimpleNamespace(
+        content='{"value":"' + PRIVATE + '"}',
+        metadata=deepcopy(NATIVE), mocked=False,
+    )
+    context = SimpleNamespace(
+        response_format={"type": "json_schema", "schema": SCHEMA},
+        trace=SimpleNamespace(trace_id="fixture-trace-123"),
+    )
+    with pytest.raises(ModelDockError) as caught:
+        router._text_api_response(context, response)
+    records = [r for r in caplog.records if r.name == "src.router.request_router"]
+    assert len(records) == 1
+    record = records[0]
+    assert record.exc_info is None
+    assert record.stack_info is None
+    message = record.getMessage()
+    assert PRIVATE not in message
+    prefix = "structured_validation_diagnostic "
+    assert message.startswith(prefix)
+    diagnostic_record = json.loads(message[len(prefix):])
+    assert diagnostic_record == {"trace_id": "fixture-trace-123", "details": caught.value.details}
+    assert set(diagnostic_record["details"][0]) == DETAIL_KEYS
+
+
+def test_required_schema_name_and_enum_value_cannot_leak():
+    schema = {"type": "object", "properties": {PRIVATE: {"type": "string", "enum": [PRIVATE]}}, "required": [PRIVATE]}
+    detail = diagnostic("{}", schema=schema)
+    assert detail["reason"] == "SCHEMA_VIOLATION"
+    assert detail["schema_keyword"] == "required"
